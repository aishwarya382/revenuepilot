# Revenue Pilot AI - Environment Configuration Example
# Copy this file to .env and configure your variables

# Server Configuration
PORT=8000

# Authentication & Security
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./shopmind.db

# Razorpay Test Gateway Credentials (Get yours at https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
